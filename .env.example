# API port (default: 3000)
PORT=3000

# Allowed browser origin (default: http://localhost:5173)
WEB_ORIGIN=http://localhost:5173

# Browser API base URL (default: http://localhost:3000)
VITE_API_URL=http://localhost:3000

# PostgreSQL connection used by the migration command
DATABASE_URL=postgres://badminton:badminton@localhost:5432/badminton_scorer
