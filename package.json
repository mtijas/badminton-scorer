{
  "name": "badminton-scorer",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm --filter @badminton-scorer/api dev\" \"pnpm --filter @badminton-scorer/web dev\"",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm test:integration && pnpm test:e2e && pnpm build",
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck && tsc --noEmit --project tsconfig.json && tsc --noEmit --project e2e/tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "pnpm --filter @badminton-scorer/shared build && vitest run --exclude '**/*.integration.test.ts'",
    "test:coverage": "pnpm --filter @badminton-scorer/shared build && vitest run --coverage --exclude '**/*.integration.test.ts'",
    "test:integration": "DATABASE_URL=${TEST_DATABASE_URL:-postgres://badminton:badminton@localhost:5433/badminton_scorer_test} pnpm db:migrate && DATABASE_URL=${TEST_DATABASE_URL:-postgres://badminton:badminton@localhost:5433/badminton_scorer_test} vitest run apps/api/src/repositories/postgres-match-repository.integration.test.ts",
    "test:e2e": "DATABASE_URL=${E2E_DATABASE_URL:-${DATABASE_URL:-postgres://badminton:badminton@localhost:5432/badminton_scorer}} pnpm db:migrate && DATABASE_URL=${E2E_DATABASE_URL:-${DATABASE_URL:-postgres://badminton:badminton@localhost:5432/badminton_scorer}} playwright test",
    "db:migrate": "node-pg-migrate up --migrations-dir database/migrations --database-url-var DATABASE_URL",
    "db:verify": "node database/verify-integrity.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^2.1.9",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.22.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  }
}
