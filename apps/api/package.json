{
  "name": "@badminton-scorer/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @badminton-scorer/shared build && tsx watch src/server.ts",
    "build": "pnpm --filter @badminton-scorer/shared build && tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@badminton-scorer/shared": "workspace:*",
    "@fastify/cors": "^10.0.0",
    "fastify": "^5.0.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
